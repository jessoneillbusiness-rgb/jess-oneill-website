---
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}

const { variant = 'light', class: className = '' } = Astro.props;
const variantClass = variant === 'dark' ? 'btn--outline' : 'btn--outline-dark';
---

<button type="button" class={`btn ${variantClass} media-kit-download ${className}`} data-variant={variant}>
  Download PDF
</button>
