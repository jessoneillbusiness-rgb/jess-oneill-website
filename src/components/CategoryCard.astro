---
import { categories } from '../config/site';

interface Props {
  category: (typeof categories)[number];
}

const { category } = Astro.props;
---

<a href={`/category/${category.slug}`} class="category-card">
  <div class="category-card__media">
    <img
      class="category-card__image"
      src={`/images/categories/${category.slug}.jpg`}
      alt={`${category.label} — ${category.description}`}
      loading="lazy"
      width="560"
      height="420"
    />
  </div>
  <div class="category-card__body">
    <p class="category-card__eyebrow">{category.label}</p>
    <h3 class="category-card__title">{category.description}</h3>
  </div>
</a>
