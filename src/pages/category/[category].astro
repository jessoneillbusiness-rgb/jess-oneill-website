---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories, type Category } from '../../config/site';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { categoryInfo: cat },
  }));
}

const { category } = Astro.params as { category: Category };
const { categoryInfo } = Astro.props;

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === category))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={categoryInfo.label} description={categoryInfo.description}>
  <div class="container">
    <header class="page-header">
      <p class="section__eyebrow">Category</p>
      <h1 class="page-header__title">{categoryInfo.label}</h1>
      <p class="page-header__desc">{categoryInfo.description}</p>
    </header>

    <nav class="category-nav" aria-label="Filter categories">
      {categories.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class:list={['category-pill', { 'category-pill--active': cat.slug === category }]}
        >
          {cat.label}
        </a>
      ))}
    </nav>

    {posts.length > 0 ? (
      <div class="post-grid" style="padding-bottom: 4rem;">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="text-center" style="color: var(--color-text-muted); padding-bottom: 4rem;">
        No posts in this category yet. Check back soon!
      </p>
    )}
  </div>
</BaseLayout>
