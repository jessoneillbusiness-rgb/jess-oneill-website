---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../config/site';
---

<BaseLayout title="About" description={`About ${site.name} — travel, food, beauty, and lifestyle.`}>
  <section class="section">
    <div class="container about-grid">
      <img
        class="about-image"
        src="/images/about/jess-portrait.jpg"
        alt="Jess O'Neill smiling at an outdoor restaurant"
        width="560"
        height="700"
      />
      <div class="about-content">
        <p class="section__eyebrow">About</p>
        <h2>Hi, I'm Jess — so glad you're here</h2>
        <p>
          Welcome to my corner of the internet. This is where I share the things I love most:
          discovering new destinations, finding incredible food, my beauty and wellness rituals,
          and the everyday moments that make life feel full.
        </p>
        <p>
          What started on social media has grown into this journal — a place for longer stories,
          detailed guides, and thoughts that don't fit in a caption.
        </p>
        <p>
          When I'm not writing here, you'll find me creating content, exploring somewhere new,
          or planning my next adventure. I'd love to connect — find me on your favourite platform below.
        </p>
        <div style="margin-top: 2rem;">
          <SocialLinks variant="inline" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
