---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { mediaKit } from '../config/media-kit';
import { site, socialChannels } from '../config/site';
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name} — general enquiries, collaborations, and press.`}
>
  <section class="page-header">
    <div class="container">
      <p class="section__eyebrow">Contact</p>
      <h1 class="page-header__title">Let's Connect</h1>
      <p class="page-header__desc">
        Whether you have a question, a collaboration idea, or just want to say hello — I'd love to hear from you.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <article class="contact-card contact-card--featured">
        <p class="contact-card__eyebrow">General Enquiries</p>
        <h2 class="contact-card__title">Email Me</h2>
        <p class="contact-card__desc">
          For questions, feedback, or anything related to the blog and content.
        </p>
        <a href={`mailto:${site.email}?subject=Hello%20from%20jess-oneill.com`} class="contact-card__link">
          {site.email}
        </a>
      </article>

      <article class="contact-card">
        <p class="contact-card__eyebrow">Brand & PR</p>
        <h2 class="contact-card__title">Partnerships</h2>
        <p class="contact-card__desc">
          For campaign enquiries, sponsored content, and brand collaborations.
        </p>
        <a href={`mailto:${mediaKit.contactEmail}?subject=Partnership%20Inquiry`} class="contact-card__link">
          {mediaKit.contactEmail}
        </a>
        <a href="/media-kit" class="contact-card__secondary">View Media Kit →</a>
      </article>

      <article class="contact-card">
        <p class="contact-card__eyebrow">Modeling</p>
        <h2 class="contact-card__title">Bookings</h2>
        <p class="contact-card__desc">
          For editorial, commercial, and lifestyle modeling enquiries.
        </p>
        <a href="/modeling" class="contact-card__secondary">View Portfolio →</a>
        <a href={`mailto:${site.email}?subject=Modeling%20Booking%20Enquiry`} class="contact-card__link">
          {site.email}
        </a>
      </article>
    </div>
  </section>

  <section class="section contact-social-section">
    <div class="container">
      <div class="section__header" style="border-bottom: none; padding-bottom: 0;">
        <p class="section__eyebrow">Social</p>
        <h2 class="section__title">Find Me Online</h2>
        <p class="section__desc">Follow along for daily inspiration on Instagram, TikTok, and Facebook.</p>
      </div>
      <div class="contact-social-grid">
        {socialChannels.map((channel) => (
          <a href={channel.url} class="contact-social-card" target="_blank" rel="noopener noreferrer">
            <span class="contact-social-card__name">{channel.name}</span>
            <span class="contact-social-card__handle">
              {'username' in channel && channel.username ? `@${channel.username}` : channel.name}
            </span>
          </a>
        ))}
      </div>
      <div class="text-center mt-3">
        <SocialLinks variant="inline" />
      </div>
    </div>
  </section>
</BaseLayout>
